#!/usr/bin/env bash
# cmux-sealed — launch a cmux workspace in the SEALED (confidential) tier, or verify the posture.
#
# The cmux-side analog of scripts/hearth_private.sh. It enforces the C0 §4 seal invariant
# (docs/cmux/AUDIT.md) and FAILS CLOSED: if it cannot prove no-egress, it does not launch.
# See docs/cmux/DECISIONS.md ADR-C001/C003/C006 and docs/cmux/PRIVACY.md.
#
# Seal model (ADR-C006): the STRUCTURAL guarantee is an OS-level loopback-only egress firewall
# (pf), because cmux's in-app browser and iroh have no in-code off switch. Tier=sealed and a
# no-egress HEARTH are the other mandatory gates. Telemetry/Sparkle/signed-out are defense-in-depth.
#
# Usage:
#   scripts/cmux/cmux-sealed --check [REPO]      # verify posture only; exit 0 iff sealed-clean
#   scripts/cmux/cmux-sealed [REPO]              # verify, then launch cmux sealed (REPO default: cwd)
#   scripts/cmux/cmux-sealed --strict ...        # also fail on advisory (telemetry/Sparkle/sign-in) checks
#   scripts/cmux/cmux-sealed --install-firewall  # load the pf egress anchor (needs sudo)
#   scripts/cmux/cmux-sealed --remove-firewall   # unload the pf egress anchor (needs sudo)
#
# Exit: 0 = sealed-clean (mandatory gates pass; +advisory under --strict). Non-zero = NOT sealed.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CMUX_BUNDLE_ID="${CMUX_BUNDLE_ID:-com.cmuxterm.app}"
PF_ANCHOR="cmux-sealed"
PF_CONF="$REPO_ROOT/scripts/cmux/cmux-sealed.pf.conf"

CHECK_ONLY=0; STRICT=0; MODE="run"; REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK_ONLY=1; shift ;;
    --strict) STRICT=1; shift ;;
    --install-firewall) MODE="install-fw"; shift ;;
    --print-rules) MODE="print-rules"; shift ;;
    --remove-firewall) MODE="remove-fw"; shift ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 64 ;;
    *) REPO="$1"; shift ;;
  esac
done
REPO="${REPO:-$(pwd)}"

pass() { printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; }
warn() { printf '  \033[33mWARN\033[0m  %s\n' "$1"; }

# --- firewall install/remove (structural egress seal; needs sudo) ------------------------------
# The sealed-uid rule set. ALL protocols and both address families, not just tcp/udp: the earlier
# `proto { tcp udp }` rules left ICMP (a tunnel) open (DESIGN_C7 §3). `block return` answers a TCP SYN with
# an RST and a UDP datagram with ICMP unreachable, so a block is fast and distinguishable from a dead
# network; other protocols are dropped. Loopback is passed first and `quick`, so 127.0.0.0/8 and ::1 work.
# This is a rule TEXT only: whether pf enforces it, and whether it catches a pane child's sockets, is
# measured by scripts/cmux/pane_egress_probe.sh, never by this file (ADR-C008).
sealed_rules() {
  printf 'pass quick on lo0 all\nblock return out quick all user %s\n' "$1"
}
if [ "$MODE" = "print-rules" ]; then
  uid="${CMUX_SEALED_UID:-}"
  case "$uid" in ''|*[!0-9]*) echo "--print-rules needs CMUX_SEALED_UID set to a numeric uid" >&2; exit 64 ;; esac
  sealed_rules "$uid"; exit 0
fi
if [ "$MODE" = "install-fw" ]; then
  SEALED_UID="${CMUX_SEALED_UID:-$(id -u)}"
  case "$SEALED_UID" in ''|*[!0-9]*) echo "CMUX_SEALED_UID must be a numeric uid, got '$SEALED_UID'" >&2; exit 64 ;; esac
  echo "==> pf egress seal: loopback-only for uid $SEALED_UID. Needs sudo."
  echo "    WARNING: this blocks NON-loopback traffic for that uid — the login user's browser/apps lose"
  echo "    internet until '$0 --remove-firewall'. To scope to cmux ONLY, run cmux as a dedicated user"
  echo "    and set CMUX_SEALED_UID to its uid."
  rules="$(mktemp)"
  sealed_rules "$SEALED_UID" > "$rules"
  if sudo pfctl -a "$PF_ANCHOR" -f "$rules"; then
    sudo pfctl -e 2>/dev/null || true   # enable pf (ignore 'already enabled')
    rm -f "$rules"
    echo "==> anchor '$PF_ANCHOR' loaded. ⚠ On stock macOS an anchor is ENFORCED only if /etc/pf.conf"
    echo "    references it (a line: anchor \"$PF_ANCHOR\"). If it doesn't, these rules are DORMANT — do"
    echo "    not trust them. The authoritative check is scripts/cmux/cmux_egress_probe.sh."
    echo "    Reliable, app-scoped alternative (recommended): LuLu (free) or Little Snitch — block cmux."
  else
    rm -f "$rules"
    echo "==> ERROR: pfctl failed to load the rules. Firewall NOT active." >&2
    exit 1
  fi
  exit 0
fi
if [ "$MODE" = "remove-fw" ]; then
  echo "==> flushing pf anchor '$PF_ANCHOR'. Needs sudo."
  sudo pfctl -a "$PF_ANCHOR" -F all 2>/dev/null || true
  exit 0
fi

echo "==> cmux-sealed — verifying SEALED posture for: $REPO"
echo "    bundle=$CMUX_BUNDLE_ID  pf-anchor=$PF_ANCHOR  strict=$STRICT"
echo
mandatory_ok=1; advisory_ok=1

# 1) MANDATORY: repo classifies to the sealed tier (ADR-C003).
# --no-sync: a bare `uv run` re-syncs the venv to the default set and uninstalls mlx — and
# with output discarded here, it would do so silently on every sealed launch (CLAUDE.md §1).
if uv run --no-sync --project "$REPO_ROOT" python "$REPO_ROOT/scripts/cmux/tier_classify.py" "$REPO" --require-sealed >/dev/null 2>&1; then
  pass "tier: '$REPO' classifies as sealed (config/cmux/tiers.yaml)"
else
  fail "tier: '$REPO' does NOT classify as sealed — refusing (default-sealed means this is a config or path error)"
  mandatory_ok=0
fi

# 2) MANDATORY: HEARTH has no egress path (reuse the engine's own sealed check).
if "$REPO_ROOT/scripts/hearth_private.sh" --check >/dev/null 2>&1; then
  pass "hearth: no-egress posture verified (0 remotes, all classes local/never)"
else
  fail "hearth: sealed posture check failed (scripts/hearth_private.sh --check) — a remote may resolve"
  mandatory_ok=0
fi

# 3) MANDATORY: an OS-level egress seal is present (the structural seal, ADR-C006 #5).
#
#    This gate used to pass whenever a LuLu/Little Snitch PROCESS was running. That is not a seal:
#    on 2026-08-17 this machine had LuLu running *with an explicit ALLOW *:* rule for cmux*, and the
#    gate happily reported sealed. A running firewall that permits the app is worse than no firewall,
#    because it manufactures confidence. So we now read LuLu's actual rule store and require a real
#    block rule. Undetermined (unreadable store / format change) FAILS — never assume a seal.
#
#    NOTE: rule state still is not proof of OUTCOME. The authoritative confirmation of no-egress is
#    scripts/cmux/cmux_egress_probe.sh reporting loopback-only while cmux runs.
#    (The verifier's non-zero exits are VERDICTS, not errors, so they must not trip `set -e`.)
lulu_verdict=""
lulu_rc=2
if [ -r /Library/Objective-See/LuLu/rules.plist ]; then
  if lulu_verdict="$(python3 "$REPO_ROOT/scripts/cmux/lulu_rule_check.py" --app "$CMUX_BUNDLE_ID" 2>&1)"; then
    lulu_rc=0
  else
    lulu_rc=$?
  fi
fi

if [ "$lulu_rc" = 0 ]; then
  pass "firewall: LuLu blocks '$CMUX_BUNDLE_ID' for all endpoints — confirm with the egress probe"
elif [ "$lulu_rc" = 1 ]; then
  fail "firewall: LuLu is present but does NOT block cmux — ${lulu_verdict%%$'\n'*}"
  echo "         Fix: LuLu → Rules → find '$CMUX_BUNDLE_ID' → set the action to Block (or delete the"
  echo "         allow rule so LuLu prompts, then choose Block). Re-run this check afterwards."
  mandatory_ok=0
elif [ "$lulu_rc" = 3 ]; then
  # The nastiest state: the rule is RIGHT and nothing enforces it. Found live 2026-08-17.
  fail "firewall: LuLu's rule blocks cmux but its network filter is NOT running — nothing is enforcing it"
  echo "         ${lulu_verdict%%$'\n'*}"
  echo "         Fix: launch LuLu.app and re-approve its system extension (System Settings → General →"
  echo "         Login Items & Extensions → Network Extensions); a reboot may be required. Then re-check."
  mandatory_ok=0
elif { sudo -n pfctl -a "$PF_ANCHOR" -sr 2>/dev/null || pfctl -a "$PF_ANCHOR" -sr 2>/dev/null; } | grep -q 'block'; then
  # No readable LuLu store; fall back to the pf anchor. Still not proof — see the pf.conf caveats.
  pass "firewall: pf anchor '$PF_ANCHOR' loaded — confirm it is ENFORCED with the egress probe"
else
  fail "firewall: no egress seal detected. Block cmux in LuLu/Little Snitch, or run '$0 --install-firewall' (pf). The egress probe is the real proof."
  mandatory_ok=0
fi

# 4) MANDATORY: workspace containment — what a CHILD OF A PANE can reach (B-002, FINDING_pane_egress).
#    Gate 3 inspects configuration (rules, anchors); on 2026-08-19 every one of those said SEALED while
#    a pane's curl returned http=200. This gate asserts on the OUTCOME via scripts/cmux/pane_containment.py:
#    six attempts in the pane, the same six in a control, uid + loopback identity checks. Only CONTAINED
#    passes. LEAKS, INCONCLUSIVE (incl. "no pane/uid configured"), and a crashed verifier all FAIL.
#    Configure with CMUX_SEALED_SURFACE (pane surface id) and CMUX_SEALED_UID. Not built yet: with
#    neither set this reports INCONCLUSIVE and fails closed. (Verdict exit codes must not trip `set -e`.)
contain_out=""
if contain_out="$(python3 "$REPO_ROOT/scripts/cmux/pane_containment.py" 2>&1)"; then contain_rc=0; else contain_rc=$?; fi
if [ "$contain_rc" = 0 ]; then
  pass "workspace-containment: CONTAINED — pane attempts blocked, control reached (measured this run only)"
elif [ "$contain_rc" = 3 ]; then
  fail "workspace-containment: LEAKS — a pane child reached the network"
  echo "$contain_out" | sed 's/^/         /'
  mandatory_ok=0
elif [ "$contain_rc" = 4 ]; then
  fail "workspace-containment: INCONCLUSIVE — containment cannot be shown (fails closed)"
  echo "$contain_out" | sed 's/^/         /'
  echo "         Design and what to configure: docs/cmux/DESIGN_C7_containment.md"
  mandatory_ok=0
else
  fail "workspace-containment: verifier error (exit $contain_rc) — failing closed; see docs/cmux/DESIGN_C7_containment.md"
  echo "$contain_out" | sed 's/^/         /'
  mandatory_ok=0
fi

# --- advisory (defense-in-depth; C0 §4 #1-#4). WARN by default; FAIL under --strict. -----------
adv() { if [ "$STRICT" = 1 ]; then fail "$1"; advisory_ok=0; else warn "$1"; fi; }

tele="$(defaults read "$CMUX_BUNDLE_ID" sendAnonymousTelemetry 2>/dev/null || echo MISSING)"
if [ "$tele" = "0" ]; then pass "telemetry: sendAnonymousTelemetry=0 (PostHog/Sentry off)"; else
  adv "telemetry: sendAnonymousTelemetry='$tele' (want 0 before first launch; default is ON)"; fi

spark="$(defaults read "$CMUX_BUNDLE_ID" SUEnableAutomaticChecks 2>/dev/null || echo MISSING)"
if [ "$spark" = "0" ]; then pass "auto-update: SUEnableAutomaticChecks=0 (Sparkle off)"; else
  adv "auto-update: SUEnableAutomaticChecks='$spark' (want 0; Sparkle probes GitHub at launch)"; fi

if [ "${CMUX_CLI_SENTRY_DISABLED:-}" = "1" ] && [ "${CMUX_CLAUDE_HOOK_SENTRY_DISABLED:-}" = "1" ]; then
  pass "cli-telemetry: CMUX_CLI_SENTRY_DISABLED + CMUX_CLAUDE_HOOK_SENTRY_DISABLED set"; else
  adv "cli-telemetry: export CMUX_CLI_SENTRY_DISABLED=1 and CMUX_CLAUDE_HOOK_SENTRY_DISABLED=1 (separate env-only gate)"; fi

# best-effort signed-out: look for a cmux auth item in the login keychain.
if security find-generic-password -s "$CMUX_BUNDLE_ID" >/dev/null 2>&1; then
  adv "sign-in: a cmux keychain item exists — may be signed IN (signed-out disables cloud+iroh; best-effort)"; else
  pass "sign-in: no cmux auth item found in keychain (best-effort: appears signed out)"; fi

echo
GATE_OK=$mandatory_ok
[ "$STRICT" = 1 ] && [ "$advisory_ok" = 0 ] && GATE_OK=0
if [ "$GATE_OK" != 1 ]; then
  echo "==> RESULT: NOT SEALED — failing closed, will not launch. (fix the FAILs above)"; exit 2
fi
echo "==> RESULT: sealed posture verified.$([ "$STRICT" = 1 ] && echo ' (strict)')"

if [ "$CHECK_ONLY" = 1 ]; then echo "==> --check only; not launching."; exit 0; fi

# --- launch cmux in the sealed workspace -------------------------------------------------------
export CMUX_CLI_SENTRY_DISABLED=1 CMUX_CLAUDE_HOOK_SENTRY_DISABLED=1
APP="/Applications/cmux.app"
echo "==> launching cmux SEALED at $REPO (telemetry env set; egress fenced by pf)…"
if [ -d "$APP" ]; then
  open -a "$APP" "$REPO"
else
  echo "    cmux.app not found at $APP. Launch your cmux build with cwd=$REPO and the env above;"
  echo "    run 'scripts/cmux/cmux_egress_probe.sh' alongside to confirm loopback-only (AUDIT §9)."
fi
